{
  "name": "tradementor-v2",
  "version": "2.0.0",
  "private": true,
  "description": "TradeMentor V2 — Thin Events, Fat Queries",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "backtest": "tsx scripts/backtest.ts",
    "engine": "pnpm --filter @tm/engine dev",
    "web": "pnpm --filter @tm/web dev"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
