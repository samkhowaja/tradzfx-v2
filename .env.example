# ── TimescaleDB (V2) ──────────────────────────────────────────────────────────
TM_DB_HOST=localhost
TM_DB_PORT=5433
TM_DB_NAME=tradementor_v2
TM_DB_USER=postgres
TM_DB_PASSWORD=2k16Dub@i
TM_DB_POOL_MAX=20
# Web-app queries are killed after this many milliseconds at the DB level.
# Engine/backfill processes should leave this unset so long-running jobs survive.
TM_DB_STATEMENT_TIMEOUT=60000
# Idle transactions are killed after this many milliseconds.
TM_DB_IDLE_IN_TRANSACTION_TIMEOUT=300000

# ── Legacy PostgreSQL (V1, for seeding only) ──────────────────────────────────
TM_V1_DB_HOST=localhost
TM_V1_DB_PORT=5432
TM_V1_DB_NAME=tradementor
TM_V1_DB_USER=postgres
TM_V1_DB_PASSWORD=2k16Dub@i

# ── Redis ─────────────────────────────────────────────────────────────────────
TM_REDIS_URL=redis://localhost:6380

# ── MT5 EA API Key ────────────────────────────────────────────────────────────
TM_MT5_API_KEY=tm_mt5_your_key_here

# ── Kimi AI (Week 3-4) ────────────────────────────────────────────────────────
# TM_KIMI_API_KEY=your_kimi_key_here
# TM_KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── Execution ─────────────────────────────────────────────────────────────────
TM_EXECUTION_ENABLED=false
TM_EXECUTION_PAPER_MODE=true
