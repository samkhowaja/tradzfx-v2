# ── TimescaleDB (tradzfx-v2) ──────────────────────────────────────────────────
TM_DB_HOST=localhost
TM_DB_PORT=5432
TM_DB_NAME=tradzfx_v2
TM_DB_USER=postgres
# Required: set via your environment or a .env.local file (never commit secrets).
TM_DB_PASSWORD=
TM_DB_POOL_MAX=20
# Web-app queries are killed after this many milliseconds at the DB level.
# Engine/backfill processes should leave this unset so long-running jobs survive.
TM_DB_STATEMENT_TIMEOUT=60000
# Idle transactions are killed after this many milliseconds.
TM_DB_IDLE_IN_TRANSACTION_TIMEOUT=300000

# ── Redis ─────────────────────────────────────────────────────────────────────
TM_REDIS_URL=redis://localhost:6380

# ── MT5 EA API Key ────────────────────────────────────────────────────────────
# Required: set via your environment or a .env.local file (never commit secrets).
TM_MT5_API_KEY=

# ── Internal ingestion → Next.js trigger key ──────────────────────────────────
# Required when INGESTION_FORWARD_TRIGGER is true. Used by tz-ingestion to call
# tz-web-v2 /api/internal/trigger. Never commit the real value.
INTERNAL_TRIGGER_API_KEY=

# ── Kimi AI (Week 3-4) ────────────────────────────────────────────────────────
# TM_KIMI_API_KEY=your_kimi_key_here
# TM_KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── Execution ─────────────────────────────────────────────────────────────────
TM_EXECUTION_ENABLED=false
TM_EXECUTION_PAPER_MODE=true

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
# Set to "false" to disable even when token/chat are present.
# TELEGRAM_ENABLED=true

# ── Ninja Turtle robot (off by default in V2) ─────────────────────────────────
NINJA_LIVE_ENABLED=false
NINJA_LIVE_MODE=paper
NINJA_SYMBOLS=XAUUSD
NINJA_LOT_SIZE=0.01

# ── Small-account / position safety ───────────────────────────────────────────
MAX_LOT_PER_ORDER=1.0
SMALL_ACCOUNT_MAX_TOTAL=1
SMALL_ACCOUNT_MAX_PER_SYMBOL=1
SMALL_ACCOUNT_COOLDOWN_MINUTES=30
SMALL_ACCOUNT_MAX_DAILY_LOSS_PCT=5

# ── Feature queue / lifecycle ─────────────────────────────────────────────────
# Feature jobs are disabled until a worker is intentionally deployed.
# Set to "false" to re-enable enqueue from the ingest route.
TM_DISABLE_FEATURE_JOBS=true
# Comma-separated list of lifecycle tables to skip during refresh.
TM_LIFECYCLE_SKIP_TABLES=features_ifvg

# ── Engine scheduler ──────────────────────────────────────────────────────────
# Runs the live feature pipeline every N milliseconds independent of MT ingest.
# Disable in dev if you do not want background pipeline ticks.
TM_ENGINE_SCHEDULER_ENABLED=true
TM_ENGINE_SCHEDULER_INTERVAL_MS=60000

# ── Backtest / calibration defaults ───────────────────────────────────────────
# TM_CALIBRATION_DAYS=30
# TM_CALIBRATION_WALK_FORWARD_DAYS=15

# ── Feature configuration ─────────────────────────────────────────────────────
# EMA_CROSS_PAIRS=9/21
# MA_PERIODS=9,21,50,200
# BOLLINGER_CONFIGS=20,2
# SESSION_WINDOWS=Asia,London,NY,Overlap,LateNY
# ZONE_BACKFILL_SKIP_OUTCOMES=false
# ZONE_USE_LEARNED_QUALITY=false

# ── Phase 2 simplified feature toggles ─────────────────────────────────────────
# FVG / IFVG
# IFVG_MIN_FILL_PCT=0.5
# IFVG_MAX_AGE_BARS=50
# IFVG_MIN_CONFIRMATIONS=1

# Order block
# OB_MAX_LOOKBACK_BARS=15

# Structure confirmation (replaces the old 30-minute CISD window)
# CONFIRMATION_WINDOW_BARS=5

# Pricing / OTE
# PRICING_USE_IMPULSE_LEG=false

# Candle pattern
# CANDLE_PATTERN_LOOKBACK_BARS=3
# CANDLE_PATTERN_MIN_CONFIDENCE=0.5
# CANDLE_PATTERN_MIN_BODY_PCT_OF_ATR=0.0
